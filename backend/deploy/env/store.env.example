# /etc/backend/store-<name>.env - one per store instance (backend-store@<name>.service): session, events.
# The heap, -Xms and -Xmx both: maxmemory in the store's configuration is about 40 % of it, since ZGC
# makes the same data estimate 25-50 % larger than it was (docs/operations/01-deploy.md §3).
STORE_HEAP=8g
