# /etc/backend/account.env - read by backend-account.service (D-117, docs/detailed-design/10-accounts.md §3.1). Its
# secrets are here too, at the end, the signing key among them, so the file is root's alone, 0600: systemd reads it
# before the process starts (D-102; docs/operations/01-deploy.md, "Secrets"). A setting refused stops it (exit 2).
# This machine's private address: the front's nginx reaches every machine's account service at /account (D-82), and
# the firewall lets the other two machines alone reach it (docs/operations/05 §5).
ACCOUNT_BIND=10.0.0.1
ACCOUNT_PORT=8070
# Whose X-Forwarded-For is believed besides this machine's: the front's nginx, which can be any of the three.
ACCOUNT_TRUSTED_PROXIES=10.0.0.1,10.0.0.2,10.0.0.3
# Its own database on the backend's MySQL, over TLS checked against the private CA, as the platform's (operations/01
# §9); on a machine with a replica, both hosts, and it follows the primary (D-35).
ACCOUNT_DB_URL=jdbc:mysql://10.0.0.1:3306/account?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/etc/backend/tls/mysql-ca.p12&trustCertificateKeyStoreType=PKCS12
ACCOUNT_DB_USER=account
#ACCOUNT_DB_POOL_SIZE=8

# The tokens (10 §3.4): the issuer they carry, the site's address with /account, which every platform's
# BACKEND_ACCOUNT_ISSUER names exactly; and the backend's name, which their aud holds.
ACCOUNT_ISSUER=https://203.0.113.10/account
ACCOUNT_AUDIENCE=backend
# Where its events go (10 §3.5): the platforms' receivers on the private network, this machine's first, tried in turn.
ACCOUNT_EVENTS_URL=http://10.0.0.1:8080/v1/account-events,http://10.0.0.2:8080/v1/account-events,http://10.0.0.3:8080/v1/account-events

# Metrics, on loopback only, read by this machine's watch as account=127.0.0.1:9104 (docs/operations/08).
ACCOUNT_METRICS_ADDR=127.0.0.1:9104

# The secrets (D-102), each as it is, unquoted: the database's password, the value the install made in
# /etc/backend/credentials/; and the signing key, which scripts/account-key.sh prints as this line (10 §3.4):
#   /opt/backend/scripts/account-key.sh | grep '^ACCOUNT_SIGNING_KEY=' >> /etc/backend/account.env
# The same key on every machine, so each platform takes every account service's tokens. To rotate it: the old key's
# public half (the script's second line) in ACCOUNT_RETIRED_KEYS, the new key here, restart; after 15 minutes, the
# retired one out. Never in a unit's Environment=, which systemctl show prints to any user.
#ACCOUNT_DB_PASSWORD=
#ACCOUNT_SIGNING_KEY=
#ACCOUNT_RETIRED_KEYS=
