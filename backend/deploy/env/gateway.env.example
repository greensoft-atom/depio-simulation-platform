# /etc/backend/gateway.env - read by backend-gateway.service.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8090
PLATFORM_URL=http://127.0.0.1:8080
STORE_HOST=10.0.0.1
STORE_PORT=6379
# The session store with its replica (D-34, operations/01 §3): the process uses whichever is the
# primary and follows a promotion by itself. Set, it is used instead of STORE_HOST and STORE_PORT,
# which stay set all the same: the unit passes them as arguments, and an empty port stops the
# process (exit 2, not restarted) (O-22).
#BACKEND_STORE_ADDRESSES=10.0.0.1:6379,10.0.0.2:6379

# Metrics for this machine's scraper, on loopback only (docs/operations/01-deploy.md).
BACKEND_METRICS_ADDR=127.0.0.1:9103
# The certificate nginx serves here, so its expiry is a metric: nginx exports nothing (operations/01 §11).
BACKEND_EDGE_CERTIFICATE=/etc/backend/tls/fullchain.pem
