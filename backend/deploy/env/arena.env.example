# /etc/backend/arena-<name>.env - one per backend-arena@<name> instance; each needs its own
# port. The arena is reached directly by clients (D-5: match traffic never passes nginx), so
# it binds a public interface and advertises the address clients should dial.
ARENA_PORT=9001
MAP_SIZE=5700
MAX_PLAYERS=150
SHAPES=1500
MAX_ROOMS=4
# 0 for the continuous public arena; seconds per match for a timed mode.
MATCH_SECONDS=0
ARENA_BIND=0.0.0.0
# What clients are told to dial: this machine's one public name, the one its nginx serves too
# (operations/01 §11). With TLS it must be on the certificate, or the arena refuses to start:
# clients check it (operations/01 §8).
ADVERTISE_HOST=a.example.com
STORE_HOST=10.0.0.1
STORE_PORT=6379
# The session store with its replica (D-34, operations/01 §3): the process uses whichever is the
# primary and follows a promotion by itself. Set, it is used instead of STORE_HOST and STORE_PORT,
# which stay set all the same: the unit passes them as arguments, and an empty port stops the
# process (exit 2, not restarted) (O-22).
#BACKEND_STORE_ADDRESSES=10.0.0.1:6379,10.0.0.2:6379

# Metrics for this machine's scraper, on loopback; one port per arena instance.
BACKEND_METRICS_ADDR=127.0.0.1:9110

# The events instance of j-redis (D-7), which holds the result queue apart from sessions and
# leaderboards. Unset, results share the store above. Its password falls back to the store's;
# a different one arrives as BACKEND_EVENTS_STORE_PASSWORD_FILE via LoadCredential.
#BACKEND_EVENTS_STORE=10.0.0.2:6380
# With its replica, on machine C: both addresses, in any order.
#BACKEND_EVENTS_STORE=10.0.0.2:6380,10.0.0.3:6380

# TLS: not set here. The keystore and its password are credentials, made by
# scripts/install-certificate.sh and delivered by the drop-in deploy/systemd/arena-tls.conf.example.
