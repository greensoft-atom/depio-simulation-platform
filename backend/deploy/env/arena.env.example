# /etc/backend/arena-<name>.env - one per backend-arena@<name> instance: a1, a2 on A, b1 to b3 on B,
# c1, c2 on C (D-82, docs/operations/05 §3). Players reach an arena through the front's nginx on the
# site's 9001, which ends their TLS and passes each connection to the arena its handshake named, in
# plaintext; so the arena listens on a private port of its own, and announces the site's address,
# 9001, and its own name.
# The machine's first arena 9011, its second 9012, its third 9013: 9001 is nginx's on every machine.
ARENA_PORT=9011
MAP_SIZE=5700
MAX_PLAYERS=150
SHAPES=1500
# 12 rooms of 150 are 1 800 players, short of where an arena's two network threads fill, 2 100 to
# 2 300 (operations/04 §2.5).
MAX_ROOMS=12
# 0 for the continuous public arena; seconds per match for a timed mode.
MATCH_SECONDS=0
# This machine's private address, where the front's nginx reaches it.
ARENA_BIND=10.0.0.1
# What clients are told to dial: the site's public address and port, the front's.
ADVERTISE_HOST=203.0.113.10
BACKEND_ADVERTISE_PORT=9001
# The name a client's TLS handshake gives, which the front's nginx routes by (backend-stream.conf's map)
# and the site's certificate names; each arena its own. Set, the arena announces TLS, which nginx ends,
# and speaks plaintext itself: no keystore with it.
BACKEND_ADVERTISE_TLS_NAME=a1.arena.internal
STORE_HOST=10.0.0.1
STORE_PORT=6379
# The session store with its replica (D-34, operations/01 §3): the process uses whichever is the
# primary and follows a promotion by itself. Set, it is used instead of STORE_HOST and STORE_PORT,
# which stay set all the same: the unit passes them as arguments, and an empty port stops the
# process (exit 2, not restarted) (O-22).
#BACKEND_STORE_ADDRESSES=10.0.0.1:6379,10.0.0.2:6379

# Metrics for this machine's scraper, on loopback; one port per arena instance: the first 9110, the
# second 9111, the third 9113 (9112 is the second worker's on C).
BACKEND_METRICS_ADDR=127.0.0.1:9110

# The events instance of j-redis (D-7), which holds the result queue apart from sessions and
# leaderboards. Unset, results share the store above. Its password falls back to the store's;
# a different one arrives as BACKEND_EVENTS_STORE_PASSWORD_FILE via LoadCredential.
#BACKEND_EVENTS_STORE=10.0.0.2:6380
# With its replica, on machine C: both addresses, in any order.
#BACKEND_EVENTS_STORE=10.0.0.2:6380,10.0.0.3:6380

# How long the result stream keeps a result, in hours, 1 to 168 (D-83). Every add trims what is older,
# so the same value on every arena and in worker.env: the shortest wins. It sizes the events store
# (operations/04 §3.4) and is the longest the workers or MySQL may be down before a result is lost.
#BACKEND_RESULT_RETENTION_HOURS=24

# TLS of the arena's own, without the front (a drill, a machine alone reached directly): the keystore
# and its password are credentials, delivered by the drop-in deploy/systemd/arena-tls.conf.example,
# without BACKEND_ADVERTISE_TLS_NAME. Not in the site's layout (D-82).
