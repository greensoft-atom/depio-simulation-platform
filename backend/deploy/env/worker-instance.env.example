# /etc/backend/worker-<id>.env - one per backend-worker@<id> instance, read after worker.env,
# so what it sets wins. Only what must differ between two workers on one machine.
#   worker-c1.env: BACKEND_METRICS_ADDR=127.0.0.1:9102
#   worker-c2.env: BACKEND_METRICS_ADDR=127.0.0.1:9112
BACKEND_METRICS_ADDR=127.0.0.1:9102
