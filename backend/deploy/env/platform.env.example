# /etc/backend/platform.env - read by backend-platform.service. No secrets here: the
# passwords arrive through LoadCredential (docs/operations/01-deploy.md, "Secrets").
# This machine's private address: the front's nginx reaches every machine's platform (D-82), and
# the gateway here calls it there too (gateway.env's PLATFORM_URL). The firewall lets the other two
# machines alone reach it (docs/operations/05 §5).
PLATFORM_BIND=10.0.0.1
PLATFORM_PORT=8080
# Whose X-Forwarded-For is believed besides this machine's: the front's nginx, which can be any of
# the three (D-82). IP addresses only; anything else refuses the start (exit 2).
BACKEND_TRUSTED_PROXIES=10.0.0.1,10.0.0.2,10.0.0.3
STORE_HOST=10.0.0.1
STORE_PORT=6379
# The session store with its replica (D-34, operations/01 §3): the process uses whichever is the
# primary and follows a promotion by itself. Set, it is used instead of STORE_HOST and STORE_PORT,
# which stay set all the same: the unit passes them as arguments, and an empty port stops the
# process (exit 2, not restarted) (O-22).
#BACKEND_STORE_ADDRESSES=10.0.0.1:6379,10.0.0.2:6379
# TLS to the database, checked against a private CA (operations/01 §9). sslMode alone cannot
# connect: the driver would look for that CA among the public ones.
BACKEND_DB_URL=jdbc:mysql://10.0.0.1:3306/backend?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/etc/backend/tls/mysql-ca.p12&trustCertificateKeyStoreType=PKCS12
BACKEND_DB_USER=backend

# Metrics, on loopback only, read by this machine's watch (docs/operations/01-deploy.md, 08).
BACKEND_METRICS_ADDR=127.0.0.1:9101

# The watch (docs/operations/08-monitoring.md, D-86): this machine's processes' metrics by job, the other
# machines' platforms by name, this machine's name on its alerts, and where alerts go. Machine A's: on B
# the arenas are 9110, 9111 and 9113 and the peers A and C; on C two arenas, workers 9102 and 9112, peers
# A and B. BACKEND_WATCH_TARGETS unset turns the watch off.
BACKEND_WATCH_TARGETS=platform=127.0.0.1:9101,gateway=127.0.0.1:9103,arena=127.0.0.1:9110,arena=127.0.0.1:9111
BACKEND_WATCH_PEERS=B=10.0.0.2:8080,C=10.0.0.3:8080
BACKEND_WATCH_MACHINE=A
#BACKEND_WATCH_DISKS=/,/var/lib,/var/log,/opt/backend
# Where alerts go (Q-60), a URL (or _FILE); unset: listed by the admin API and logged, sent nowhere.
#BACKEND_ALERT_WEBHOOK_URL=https://chat.example.test/hooks/your-hook
#BACKEND_ALERT_REPEAT_HOURS=4

# The database connection pool, for the database host's cores (06 §7). Default 16.
#BACKEND_DB_POOL_SIZE=16

# The admin API, on loopback, for the operator over SSH (04 §10). Its secret comes from the
# drop-in deploy/systemd/platform-admin.conf.example; unset, there is no admin API.
#BACKEND_ADMIN_ADDR=127.0.0.1:9120

# Gems for money (04 §8, D-68). The only provider is simulated: it grants gems to whoever asks, so
# it is for development and drills, never where players are. Unset, the payment routes answer 503.
#BACKEND_PAYMENT_PROVIDER=simulated
