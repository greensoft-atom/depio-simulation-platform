# The copy off the site (06 §10, D-71): the dumps and every closed binlog copy, encrypted, pushed
# by rsync over SSH to OFFSITE_TARGET. Enabled once the owner names the host (Q-53).
# Needs /etc/backend/offsite.env (OFFSITE_TARGET=user@host:dir); in /etc/backend/backup/, the backup user's
# (D-102), mysql-backup.cnf, the key offsite.key, kept off the machines too, as without it the copy
# cannot be read, and offsite-ssh, an SSH key for the host; and the host's own key in
# /etc/backend/offsite-known-hosts.
[Unit]
Description=backend: the backups copied off the site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=backend-backup
Group=backend-backup
Environment=MYSQL_CNF=/etc/backend/backup/mysql-backup.cnf
Environment=OFFSITE_KEY=/etc/backend/backup/offsite.key
Environment="OFFSITE_SSH=ssh -i /etc/backend/backup/offsite-ssh -o UserKnownHostsFile=/etc/backend/offsite-known-hosts -o BatchMode=yes"
EnvironmentFile=/etc/backend/offsite.env
StateDirectory=backend/mysql-dumps backend/binlog backend/offsite-mirror
StateDirectoryMode=0700
ExecStart=/opt/backend/scripts/backup-offsite.sh %S/backend/mysql-dumps %S/backend/binlog %S/backend/offsite-mirror
TimeoutStartSec=2h

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
