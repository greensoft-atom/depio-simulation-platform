# Runs backend-mysql-backup.service nightly; Persistent catches up a run missed while the
# machine was down.
[Unit]
Description=backend: nightly MySQL dump

[Timer]
# UTC, as the proof's 04:00 UTC: on local time the dump could follow the proof it is for (O-18).
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
