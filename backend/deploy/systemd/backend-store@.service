# A j-redis store, the instance being its name: backend-store@session and backend-store@events
# (docs/operations/01-deploy.md §3, D-7), on the release's runtime and j-redis server
# (docs/detailed-design/09 §4). Its configuration is /etc/backend/store-%i.conf (the release's
# jredis/conf/j-redis.conf as the template: port, bind, requirepass, replicaof, and
# dir /var/lib/backend-store/%i), its heap /etc/backend/store-%i.env (env/store.env.example).
#
# Install: the system user (useradd --system --home-dir /nonexistent --shell /usr/sbin/nologin
# jredis), both files, then systemctl enable --now backend-store@session (and @events where it
# runs). Pin it to its cores with a drop-in, CPUAffinity=, as the arenas are (§7).
[Unit]
Description=backend: the %i store (j-redis)
After=network-online.target
Wants=network-online.target

[Service]
User=jredis
Group=jredis
EnvironmentFile=/etc/backend/store-%i.env
# Private, and every file it writes: the data holds every live session token, and a heap dump
# holds the data (S-21).
StateDirectory=backend-store/%i
StateDirectoryMode=0700
LogsDirectory=backend-store/%i
LogsDirectoryMode=0700
UMask=0077
ExecStart=/opt/backend/runtime/bin/java -server -Xms${STORE_HEAP} -Xmx${STORE_HEAP} \
    -XX:+UseZGC -XX:+ZGenerational -XX:+AlwaysPreTouch \
    --add-opens java.base/java.nio=ALL-UNNAMED \
    -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/backend-store/%i \
    -Xlog:gc*:file=/var/log/backend-store/%i/gc.log:time,uptime:filecount=5,filesize=20M \
    -Djava.net.preferIPv4Stack=true -Dio.netty.leakDetection.level=disabled \
    -jar /opt/backend/jredis/lib/j-redis-server.jar /etc/backend/store-%i.conf
# 4 (fail-stop) restarts; 1 (configuration), 2 (data directory locked) and 3 (data not loadable)
# need a person. 143: SIGTERM, clean.
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=1 2 3
SuccessExitStatus=143
LimitNOFILE=65536
TimeoutStopSec=60

# Sandboxing, as the other units: nothing here needs more than its own state and log directories
# and the network. Not MemoryDenyWriteExecute: the JIT writes code and then runs it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
