    <dependency><groupId>com.backend</groupId><artifactId>persistence</artifactId></dependency>
    <dependency><groupId>com.backend</groupId><artifactId>sim</artifactId></dependency>
    <dependency><groupId>com.jredis</groupId><artifactId>j-redis-client</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
