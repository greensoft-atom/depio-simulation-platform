#!/bin/sh
# bin/j-redis-tools benchmark|check-aof|dump [options]
BASE=$(cd "$(dirname "$0")/.." && pwd)
if [ -n "${JAVA_HOME:-}" ]; then JAVA="$JAVA_HOME/bin/java"; else JAVA=java; fi
: "${JREDIS_TOOLS_JAVA_OPTS:=-Xmx2g}"
# shellcheck disable=SC2086
exec "$JAVA" --add-opens java.base/java.nio=ALL-UNNAMED $JREDIS_TOOLS_JAVA_OPTS -jar "$BASE/lib/j-redis-tools.jar" "$@"
