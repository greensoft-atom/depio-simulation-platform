<Project Sdk="Microsoft.NET.Sdk">
  <!-- The client's core, driven without Unity against the real stack (docs 08 §6): C# 7.3 on .NET Framework 4.5 alone
       (D-116), which Visual Studio 2019 builds and a Windows machine runs. The drills here compile it by Unity 2019.4's
       compiler and run it on its Mono (client/headless-drill.sh). System.ValueTuple is its tuples. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Backend.Client.Headless</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <Reference Include="System.Net.Http" />
    <ProjectReference Include="../Core/Backend.Client.Core.csproj" />
  </ItemGroup>
</Project>
