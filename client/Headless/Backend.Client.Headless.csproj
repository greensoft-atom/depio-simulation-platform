<Project Sdk="Microsoft.NET.Sdk">
  <!-- The client's core, driven without Unity against the real stack (docs 08 §6). A tool for
       this machine, not part of the app, so it may use what .NET has and Unity does not. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Backend.Client.Headless</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Backend.Client.Core.csproj" />
  </ItemGroup>
</Project>
