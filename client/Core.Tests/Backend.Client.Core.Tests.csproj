<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# 7.3 on .NET Framework 4.5 alone (D-116), what Visual Studio 2019 builds and runs in its Test Explorer. Here
       client/core-tests.sh compiles them by Unity 2019.4's compiler and runs them on its Mono, with no .NET. The test
       SDK and the adapter are the last versions that take 4.5; System.ValueTuple is the tests' tuples. -->
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET Framework 4.5's reference assemblies, for a machine with no targeting pack (VS without it). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.11.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="3.17.0" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/Backend.Client.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The contract between the Java encoder and this decoder: the same file the server's
         tests read, never a copy. -->
    <None Include="../../protocol-spike/vectors/vectors.txt" Link="vectors.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The maze's walls for one seed, as the server's generator wrote them (D-48). -->
    <None Include="../../backend/sim/src/test/resources/maze-2026.txt" Link="maze-2026.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../backend/arena/src/test/resources/motion-2026.txt" Link="motion-2026.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests' certificates and test servers' keys, made by Pki/make.sh (D-109). -->
    <None Update="Pki/*.pem;Pki/*.p12" CopyToOutputDirectory="PreserveNewest" />
    <!-- The tests' own list, held to the code by ReadmeTestListTests (DOC-31). -->
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
