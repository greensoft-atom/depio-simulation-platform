<Project Sdk="Microsoft.NET.Sdk">
  <!-- What Unity's scripting runtime compiles, 2022.3 LTS and 6 LTS alike (docs 08 §1). No
       package references: the core has no dependencies, so it drops into a Unity project as
       source or as this one assembly. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Backend.Client.Core</RootNamespace>
    <AssemblyName>Backend.Client.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
