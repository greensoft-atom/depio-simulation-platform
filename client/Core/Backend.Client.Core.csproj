<Project Sdk="Microsoft.NET.Sdk">
  <!-- What Unity 2019.4 compiles, at either API level (.NET Standard 2.0, .NET 4.x), and Visual Studio 2019 for
       .NET Framework 4.7.1; Unity 2022.3 and 6 take it as well (D-108, docs 08 §1). No package references: the
       core has no dependencies, so it drops into a Unity project as source or as this one assembly. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Backend.Client.Core</RootNamespace>
    <AssemblyName>Backend.Client.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
